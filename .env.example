# ===== 공통 =====
AIOPS_ENV=local
AIOPS_LOG_LEVEL=INFO
# 로컬: sqlite / 운영: postgresql+asyncpg://aiops:aiops@postgres:5432/aiops
AIOPS_DATABASE_URL=sqlite+aiosqlite:///./aiops.db

# ===== LLM (4.1) =====
# fake | openai | anthropic | gemini | local
AIOPS_LLM_DEFAULT_PROVIDER=fake
# 장애 시 순서대로 대체 (쉼표 구분)
AIOPS_LLM_FALLBACK_PROVIDERS=
# 에이전트별 모델 — 예: RCA 는 대형 모델, 탐지는 구축형 소형 모델
AIOPS_AGENT_LLM_PROVIDERS=
# 비용 추정 단가 (계약 단가로 설정, 미설정 모델은 비용 null): {"model": [USD/1M 입력, USD/1M 출력]}
AIOPS_LLM_PRICES={}

AIOPS_OPENAI_API_KEY=
AIOPS_OPENAI_MODEL=gpt-5-mini
AIOPS_ANTHROPIC_API_KEY=
AIOPS_ANTHROPIC_MODEL=claude-sonnet-5-5
AIOPS_GEMINI_API_KEY=
AIOPS_GEMINI_MODEL=gemini-2.5-flash

# 구축형 LLM: vLLM / Ollama 의 OpenAI 호환 엔드포인트 (Gemma, Qwen 등)
AIOPS_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
AIOPS_LOCAL_LLM_MODEL=qwen3

# ===== RAG (4.2) =====
# hash(테스트용) | openai | local
AIOPS_EMBEDDING_PROVIDER=hash
AIOPS_EMBEDDING_MODEL=bge-m3
# memory | qdrant
AIOPS_VECTOR_BACKEND=memory
AIOPS_QDRANT_URL=http://localhost:6333
AIOPS_KNOWLEDGE_DIR=data/knowledge
# none | http | llm  (http: HF TEI `/rerank` 또는 jina 스타일 `/v1/rerank`)
AIOPS_RERANKER=none
AIOPS_RERANKER_URL=http://localhost:8080
AIOPS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AIOPS_RERANKER_API_STYLE=tei

# ===== 운영 데이터 소스 (M2-01) =====
# simulated(합성 데이터) | live(Prometheus + Loki + 토폴로지 파일)
AIOPS_OPS_SOURCE=simulated
AIOPS_PROMETHEUS_URL=http://localhost:9090
AIOPS_PROMETHEUS_TOKEN=
# 메트릭→PromQL 템플릿 덮어쓰기 JSON ($service, $namespace 치환)
AIOPS_PROMETHEUS_QUERIES_FILE=
AIOPS_PROMETHEUS_LABELS=namespace=default
AIOPS_LOKI_URL=http://localhost:3100
AIOPS_LOKI_SELECTOR={app="$service"}
AIOPS_TOPOLOGY_FILE=data/topology.json

# ===== 알람 → 인시던트 자동 대응 (M2-02) =====
# Alertmanager webhook url: http://<api>/api/v1/events/alertmanager
AIOPS_AUTO_INCIDENT_ON_ALERT=false
AIOPS_AUTO_INCIDENT_MIN_SEVERITY=major
# 같은 서비스에 미해결 인시던트가 이 시간 안에 있으면 새로 만들지 않음(알람 폭주 억제)
AIOPS_AUTO_INCIDENT_DEDUP_MINUTES=30

# ===== 상황 인식 (M2-05/07) =====
AIOPS_SITUATION_MODEL_PATH=data/models/situation_lr.json
# 학습 장애 확률이 이 값 미만이면 Detection 이 LLM 없이 '장애 아님' 결정 (0=끔, 권장 0.05)
AIOPS_DETECTION_TRIAGE_THRESHOLD=0

# ===== 운영 자동화 안전장치 (2.3) =====
# true 이면 write/destructive 도구도 승인 없이 실행 (운영 환경 금지)
AIOPS_AUTO_APPROVE_ACTIONS=false
